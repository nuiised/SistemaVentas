<Window x:Class="CapaPresentacion.Vistas.ProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productos"
        Height="480"
        Width="850"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <!-- Parte h) RECURSOS: estilos reutilizables (como CSS) -->
    <Window.Resources>

        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,8,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F4E79"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Width" Value="95"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <!-- Parte a) LAYOUT: Grid de 2 columnas -->
    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Parte b) FORMULARIO dentro de un Border -->
        <Border Grid.Column="0"
                Background="#F3F6FA"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,15,0">

            <StackPanel>

                <TextBlock Text="Nuevo producto"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#1F4E79"
                           Margin="0,0,0,5"/>

                <!-- Parte c) TextBox -->
                <Label Content="Nombre"/>

                <TextBox x:Name="txtNombre"
                         ToolTip="Ej.: Inca Kola 500ml"/>

                <!-- Parte d) ComboBox con ítems escritos en XAML -->
                <Label Content="Categoría"/>

                <ComboBox x:Name="cboCategoria"
                          Height="28">

                    <ComboBoxItem Content="Bebidas"/>
                    <ComboBoxItem Content="Snacks"/>
                    <ComboBoxItem Content="Lácteos"/>
                    <ComboBoxItem Content="Limpieza"/>

                </ComboBox>

                <!-- Parte e) TextBox que solo acepta números -->
                <Label Content="Precio (S/)"/>

                <TextBox x:Name="txtPrecio"
                         PreviewTextInput="SoloDecimales"/>

                <!-- Parte f) Slider + TextBlock enlazado al Slider -->
                <Label Content="Stock"/>

                <StackPanel Orientation="Horizontal">

                    <Slider x:Name="sldStock"
                            Width="190"
                            Minimum="0"
                            Maximum="200"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"/>

                    <TextBlock Text="{Binding ElementName=sldStock, Path=Value}"
                               FontWeight="Bold"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>

                <!-- Parte g) CheckBox y botones -->
                <CheckBox x:Name="chkActivo"
                          Content="Producto activo"
                          IsChecked="True"
                          Margin="0,12,0,15"/>

                <StackPanel Orientation="Horizontal">

                    <Button Content="Guardar"
                            Click="BtnGuardar_Click"/>

                    <Button Content="Nuevo"
                            Background="Gray"
                            Click="BtnNuevo_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

        <!-- Parte i) TABLA -->
        <DockPanel Grid.Column="1">

            <TextBlock DockPanel.Dock="Top"
                       Text="Lista de productos"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#1F4E79"
                       Margin="0,0,0,8"/>

            <!-- Parte j) Buscador -->
            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">

                <TextBlock Text="Buscar:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBox x:Name="txtBuscar"
                         Width="250"
                         ToolTip="Escribe parte del nombre"
                         TextChanged="TxtBuscar_TextChanged"/>

            </StackPanel>

            <!-- Total de productos -->
            <TextBlock DockPanel.Dock="Bottom"
                       x:Name="lblTotal"
                       Text="Total: 0"
                       HorizontalAlignment="Right"
                       Margin="0,8,0,0"/>

            <!-- Tabla de productos -->
            <DataGrid x:Name="dgProductos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      AlternatingRowBackground="#EEF3F8"
                      SelectionChanged="DgProductos_SelectionChanged">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding IdProducto}"
                                        Width="45"/>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding Nombre}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Categoría"
                                        Binding="{Binding Categoria}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Precio"
                                        Binding="{Binding Precio, StringFormat='S/ 0.00'}"
                                        Width="75"/>

                    <DataGridTextColumn Header="Stock"
                                        Binding="{Binding Stock}"
                                        Width="55"/>

                    <DataGridCheckBoxColumn Header="Activo"
                                            Binding="{Binding Activo}"
                                            Width="55"/>

                </DataGrid.Columns>

            </DataGrid>

        </DockPanel>

    </Grid>

</Window>
